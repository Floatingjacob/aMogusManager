{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "aMogusManager Frontend",
  "version": "1.0.0",
  "identifier": "com.floatingjacob.aMogusManagerFrontend",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "aMogusManager - Yet Another Among Us Mod Manager",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
