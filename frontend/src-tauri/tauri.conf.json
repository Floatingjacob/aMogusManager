{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aMogusManager",
  "version": "0.1.0",
  "identifier": "com.floatingjacob.amogusmanagerui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "aMogusManager - Yet Another Among Us Mod Manager",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
